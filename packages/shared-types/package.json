{
  "name": "@community/shared-types",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "dev": "tsc -p tsconfig.esm.json && (tsc -p tsconfig.esm.json --watch --preserveWatchOutput & tsc --watch --preserveWatchOutput)"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "module": "./dist/esm/index.js",
  "sideEffects": false
}
