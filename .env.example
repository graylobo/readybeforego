# ==============================================================================
# [공통 / 모노레포 루트]
# Docker Compose 및 인프라 공유 설정
# docker-compose.yml 에서 직접 참조됩니다.
# ==============================================================================

NODE_ENV=production

# PostgreSQL (docker-compose db 서비스)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=readybeforego_db


# ==============================================================================
# [API] apps/api/.env
# NestJS 백엔드 서버
# ==============================================================================

# 서버
PORT=4000
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/readybeforego_db
# (선택) DB 커넥션 풀: 인스턴스당 최대 연결 수(기본 10), 쉬는 연결 유지 시간 ms(기본 300000 = 5분)
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=300000
# 앞단 프록시 수 (사용자 IP 판별용). Cloud Run=1(기본값), 프록시 없이 직접 받는 서버(pm2 등)=0
# TRUST_PROXY_HOPS=1
# 웹 서버(SSR)가 실제 방문자 IP를 전달할 때 쓰는 서버끼리의 비밀값. [Web]의 같은 이름 값과 일치해야 함
# 예: openssl rand -hex 32 로 생성
SSR_INTERNAL_SECRET=

# Redis (BullMQ 작업 큐 / 캐시 / Socket.IO 어댑터 / 채팅 presence)
# 로컬 docker-compose 기본값: redis://localhost:6379
# 다중 API 인스턴스에서 채팅방을 공유하려면 반드시 설정
REDIS_URL=redis://localhost:6379

# 인증
JWT_SECRET=your-very-secret-key-change-this

# URL (CORS 및 OAuth 콜백 구성에 사용)
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# 소셜 로그인 — Google
# https://console.cloud.google.com 에서 OAuth 2.0 클라이언트 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# 소셜 로그인 — Kakao
# https://developers.kakao.com 에서 앱 등록 후 발급
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/auth/kakao/callback

# 소셜 로그인 — Naver
# https://developers.naver.com 에서 앱 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:4000/auth/naver/callback

# 파일 스토리지
# STORAGE_TYPE=supabase 이면 Supabase, 값이 없으면 로컬 디스크(/uploads) 사용
STORAGE_TYPE=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=images

# 크롤러 & LLM 패러프레이징 설정
# LLM_PROVIDER=gemini 또는 openai (미설정 시 키가 존재하는 쪽으로 자동 폴백)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CRAWLER_AUTO_SCHEDULE_ENABLED=false
# 수집 명령 실행 위치
#   bullmq : 크롤러 워커(pnpm --filter api run prod:crawler-worker)가 처리 (기본값, 운영 권장)
#   inline : API 프로세스 안에서 실행 (워커 없이 로컬 개발할 때만, Cloud Run 에서는 사용 금지)
CRAWLER_DISPATCHER=bullmq



# ==============================================================================
# [Web] apps/web/.env.local
# Next.js 프론트엔드
# NEXT_PUBLIC_* 변수는 빌드 시 번들에 포함됩니다 (브라우저에 노출됨)
# ==============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# (서버 전용, NEXT_PUBLIC_ 아님) API의 SSR_INTERNAL_SECRET과 같은 값
SSR_INTERNAL_SECRET=

# 애널리틱스 (선택)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_CONSOLE_ID=
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_CLARITY_ID=
